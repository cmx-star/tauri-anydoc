{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyDoc",
  "version": "0.1.1",
  "identifier": "com.anydoc.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AnyDoc Markdown 转换器",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
